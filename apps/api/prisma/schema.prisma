// Baile Latino Platform — schema de la API. PostgreSQL (dev y prod).
// Dev local: Postgres vía docker-compose. Prod: Postgres gestionado (Railway/Neon).
//
// NOTA: los campos "enum" se guardan como String validados contra los arrays de
// @baile-latino/types, y las listas (p. ej. estilos del usuario) como CSV (se
// mantiene así por compatibilidad histórica).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7: la URL no va aquí. Para migraciones/db push vive en prisma.config.ts;
  // en runtime el cliente se conecta vía driver adapter (pg) — ver prisma.service.ts.
  provider = "postgresql"
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String? // opcional: los usuarios que solo entran con Google no tienen contraseña
  googleId         String?  @unique // vinculación con cuenta de Google
  emailVerified    Boolean  @default(false) // true si un proveedor (Google) verificó el email
  name             String
  lastName         String? // apellido(s)
  displayName      String? // nombre visible / pseudónimo: lo que ve la comunidad (vacío = `name`)
  birthDay         Int? // cumpleaños: día (1–31); dato personal, solo usuario y SUPER_ADMIN
  birthMonth       Int? // 1–12 (sin año, a propósito)
  /// RUT normalizado "12345678-5". Dato personal: solo lo ve el usuario y el SUPER_ADMIN.
  /// Único por cuenta, pero lo revisa el service (un @unique haría fallar el `db push` del deploy).
  rut              String?
  role             String   @default("BAILARIN") // UserRole
  region           String? // ChileRegion (code)
  city             String? // ciudad (área urbana, CHILE_CITIES de @baile-latino/types)
  commune          String? // comuna dentro de la ciudad
  instagramHandle  String?
  styles           String   @default("") // CSV de DanceStyle
  // Preferencia de baile: BACHATA | SALSA | AMBOS. null = todavía no la eligió,
  // y por eso se le pregunta al entrar.
  stylePreference  String?
  refreshTokenHash String?
  // Cuándo cambió la foto de perfil (versión para el caché). null = sin foto.
  avatarAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tracksCreated        Track[]               @relation("TrackCreatedBy")
  tracksAsArtist       Track[]               @relation("TrackArtist")
  ownedTracks          Track[]               @relation("TrackOwner")
  library              UserTrack[]
  trackTags            TrackTag[]
  playlists            Playlist[]
  songRequests         SongRequest[]
  requestVotes         RequestVote[]
  ytAccessRequest      YoutubeAccessRequest?
  events               Event[]               @relation("EventCreatedBy")
  communityPlaces      CommunityPlace[]      @relation("CommunityPlaceCreatedBy")
  administeredPlaces   CommunityPlace[]      @relation("CommunityPlaceAdmin")
  communityMemberships CommunityMember[]
  placeMedia           PlaceMedia[]          @relation("PlaceMediaUploadedBy")
  academyEnrollments   AcademyEnrollment[]   @relation("AcademyEnrollmentUser")
  chatMemberships      ChatParticipant[]
  chatMessages         ChatMessage[]         @relation("ChatMessageSender")
  audioFiles           AudioFile[]
  academies            AcademyMember[]
  academyVideos        AcademyVideo[]        @relation("AcademyVideoUploadedBy")
  videoReports         AcademyVideoReport[]
  academyShareLinks    AcademyShareLink[]
  avatar               UserAvatar?

  @@index([role])
  @@index([rut])
}

/** Foto de perfil (aparte de User para no cargarla en cada consulta). Pública por URL. */
model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String // base64, sin prefijo data:
  mime      String
  updatedAt DateTime @updatedAt
}

/**
 * Solicitud de un usuario para que lo habiliten a conectar su YouTube (agregarlo
 * como "test user" en Google Cloud). Una por usuario: volver a pedir actualiza el
 * correo y la vuelve a dejar PENDING. El admin la marca ADDED tras cargar el
 * correo en la consola de Google (paso manual: Google no tiene API para eso).
 */
model YoutubeAccessRequest {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String // Gmail con el que el usuario va a autorizar YouTube
  status     String    @default("PENDING") // PENDING | ADDED | REJECTED
  note       String? // nota opcional del admin
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reviewedAt DateTime?

  @@index([status])
}

model Track {
  id              String   @id @default(cuid())
  title           String
  artist          String
  style           String // DanceStyle
  substyle        String? // DanceSubstyle
  year            Int?
  source          String // TrackSource: SPOTIFY | YOUTUBE
  sourceId        String
  coverUrl        String?
  durationSec     Int?
  searchText      String? // título+artista normalizado (sin acentos, minúsculas) para buscar; lo mantiene un trigger
  viewCount       BigInt? // reproducciones (de ytMetadata.viewCount), para ordenar
  popularity      Int? // índice de popularidad de Spotify (0-100); Spotify no expone streams
  releaseDate     String? // fecha de lanzamiento de Spotify ("2024-04-04" | "2024-04" | "2024" | "" = sin dato)
  spotifyPlayable Boolean? // Spotify: ¿reproducible en el embed? false = restringida (país/licencia); null = desconocido
  isRelease       Boolean  @default(false)
  approvalStatus  String   @default("APROBADA") // TrackApprovalStatus
  scope           String   @default("CATALOG") // TrackScope: CATALOG (global) | PERSONAL (privada del DJ)
  ownerId         String? // dueño cuando scope = PERSONAL
  ytMetadata      String? // JSON con todos los datos extraídos de YouTube (snippet, stats, status, etc.)
  artistUserId    String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner         User?          @relation("TrackOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  artistUser    User?          @relation("TrackArtist", fields: [artistUserId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("TrackCreatedBy", fields: [createdById], references: [id])
  playlistItems PlaylistItem[]
  songRequests  SongRequest[]
  savedBy       UserTrack[]
  trackTags     TrackTag[]
  audioFiles    AudioFile[] // audios de usuarios vinculados a esta canción (módulo Estudio)

  // Sin unique global de (source,sourceId): el mismo video puede estar en el
  // catálogo y además como copia personal de uno o más DJs. Dedupe en la app.
  @@index([source, sourceId])
  @@index([scope])
  @@index([ownerId])
  @@index([style])
  @@index([substyle])
  @@index([viewCount])
}

/// Configuración global de la plataforma (clave/valor JSON). P.ej. la matriz
/// de permisos rol×módulo (ver/editar/eliminar).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Vocabulario global de tags (sub-estilos). Único por `slug` normalizado
/// (sin distinguir mayúsculas/acentos/puntuación). Lo administra el SUPER_ADMIN,
/// pero un DJ también puede crear uno nuevo al etiquetar.
model Tag {
  id          String   @id @default(cuid())
  name        String // texto a mostrar
  slug        String // normalizado para deduplicar (único por estilo, no global)
  style       String? // categoría: BACHATA | SALSA | null (general)
  createdById String
  createdAt   DateTime @default(now())

  tracks TrackTag[]

  // El mismo nombre puede existir en cada estilo (ej: "Romántica" en bachata y salsa).
  @@unique([slug, style])
}

/// Asociación DJ↔canción↔tag (cada DJ etiqueta según su apreciación).
model TrackTag {
  id        String   @id @default(cuid())
  trackId   String
  userId    String
  tagId     String
  createdAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([trackId, userId, tagId])
  @@index([trackId])
  @@index([tagId])
  @@index([userId])
}

/// Biblioteca personal: canciones (de catálogo o personales) en "Mis Canciones".
model UserTrack {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId])
}

model Playlist {
  id               String   @id @default(cuid())
  name             String
  source           String   @default("YOUTUBE") // plataforma: YOUTUBE | SPOTIFY
  eventId          String? // FK lógica al futuro EventsModule (sin constraint aún)
  status           String   @default("BORRADOR") // PlaylistStatus
  visibility       String   @default("SOLO_ENTRADA") // PlaylistVisibility
  targetBachataPct Int? // 0-100; resto se asume salsa
  bachatasPerBlock Int? // patrón de distribución: bachatas por bloque
  salsasPerBlock   Int? // patrón de distribución: salsas por bloque
  ownerId          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner User           @relation(fields: [ownerId], references: [id])
  items PlaylistItem[]

  @@index([ownerId])
  @@index([eventId])
}

model PlaylistItem {
  id         String  @id @default(cuid())
  playlistId String
  trackId    String
  position   Int
  isWarmup   Boolean @default(false)
  addedById  String

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  // Sin unique por (playlistId, trackId) a propósito: una playlist PUEDE tener la
  // misma canción varias veces (en un social, un tema muy bueno se repite 3-4
  // veces en una sesión de 4-5 horas). Cada aparición es un PlaylistItem propio.
  @@index([playlistId])
  @@index([trackId])
}

model SongRequest {
  id          String   @id @default(cuid())
  eventId     String?
  trackId     String
  requesterId String
  status      String   @default("PENDIENTE") // SongRequestStatus
  createdAt   DateTime @default(now())

  track     Track         @relation(fields: [trackId], references: [id], onDelete: Cascade)
  requester User          @relation(fields: [requesterId], references: [id])
  votes     RequestVote[]

  @@index([eventId])
  @@index([trackId])
}

model RequestVote {
  id        String   @id @default(cuid())
  requestId String
  userId    String
  createdAt DateTime @default(now())

  request SongRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])

  @@unique([requestId, userId])
}

/// Configuración global del sitio (fila única id="singleton"). El logo se guarda
/// como base64 en la DB para que persista entre despliegues y lo sirvan ambos
/// clientes (web/mobile) vía la API, sin depender de storage externo.
model SiteSetting {
  id        String   @id @default("singleton")
  siteName  String?
  logoData  String? // base64 del logo, sin el prefijo data:
  logoMime  String? // tipo MIME (image/png, image/svg+xml, …)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Evento de la comunidad (social, show, taller…). El flyer se guarda en base64
/// igual que el logo del sitio; las listas nunca lo seleccionan (ver events.service).
model Event {
  id                 String    @id @default(cuid())
  title              String
  description        String?
  startsAt           DateTime
  endsAt             DateTime?
  region             String // ChileRegion (code)
  city               String? // ciudad (área urbana, CHILE_CITIES de @baile-latino/types)
  commune            String? // comuna dentro de la ciudad
  venueName          String?
  address            String?
  styles             String    @default("") // CSV de DanceStyle
  bachataPct         Int? // % de bachata en la noche (0-100)
  priceInfo          String? // texto libre con precios / preventas
  ticketUrl          String?
  instagramUrl       String?
  organizerName      String?
  organizerInstagram String?
  status             String    @default("PUBLISHED") // EventStatus
  flyerData          String? // base64 del flyer, sin prefijo data:
  flyerMime          String?
  createdById        String
  createdBy          User      @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([region, startsAt])
  @@index([startsAt])
  @@index([createdById])
}

/// Ficha de un directorio de la comunidad (social al aire libre, salsoteca, DJ
/// disponible…). Sin fecha única: horario/disponibilidad en texto y las cuentas
/// de Instagram asociadas. `kind` distingue el tipo (CommunityPlaceKind).
model CommunityPlace {
  id               String                @id @default(cuid())
  kind             String // CommunityPlaceKind: OUTDOOR_SOCIAL | SALSOTECA | DJ
  name             String
  region           String // ChileRegion (code)
  city             String? // ciudad (área urbana, CHILE_CITIES de @baile-latino/types)
  commune          String? // comuna dentro de la ciudad
  lat              Float? // punto en el mapa (sociales al aire libre)
  lng              Float?
  bachataPct       Int? // mezcla: % de bachata (el resto salsa)
  place            String?
  address          String?
  schedule         String? // texto libre, ej. "Domingos desde las 17:00"
  styles           String                @default("") // CSV de DanceStyle
  description      String?
  instagramHandles String                @default("") // CSV de handles sin @
  photoData        String? // base64, sin prefijo data:
  photoMime        String?
  gallery          CommunityPlacePhoto[]
  members          CommunityMember[]
  media            PlaceMedia[]
  /// Espacio de fotos y videos (versión gratis: 5 GB galería + 20 GB bóveda). Editable por el SUPER_ADMIN.
  mediaQuotaMb     Int                   @default(5120)
  vaultQuotaMb     Int                   @default(20480)
  channels         ChatConversation[]
  active           Boolean               @default(true)
  createdById      String
  createdBy        User                  @relation("CommunityPlaceCreatedBy", fields: [createdById], references: [id])
  /// Administrador asignado por el SUPER_ADMIN: puede cambiar la foto y la galería.
  adminId          String?
  admin            User?                 @relation("CommunityPlaceAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([kind, region])
  @@index([createdById])
}

/// Galería del lugar (hasta 9 fotos; en el detalle se ven en grilla 3×3).
model CommunityPlacePhoto {
  id        String         @id @default(cuid())
  placeId   String
  place     CommunityPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  data      String // base64, sin prefijo data:
  mime      String
  position  Int // orden en la grilla (0 = primera)
  createdAt DateTime       @default(now())

  @@index([placeId, position])
}

/// Miembro de la comunidad de un lugar (hoy solo sociales al aire libre).
/// Al unirse entra al canal General; los demás canales los elige.
model CommunityMember {
  placeId  String
  userId   String
  joinedAt DateTime @default(now())

  place CommunityPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([placeId, userId])
  @@index([userId])
}

/// Fotos y videos de un social (bucket privado de media, prefijo `places/<id>/`).
/// Sube el administrador del lugar (o el SUPER_ADMIN); ven y descargan los miembros.
/// Mismo esquema que AcademyVideo: galería + bóveda (STANDARD_IA), sin copia MP4 por ahora.
model PlaceMedia {
  id           String         @id @default(cuid())
  placeId      String
  place        CommunityPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  recordedOn   DateTime? // día del social
  storageKey   String         @unique
  thumbKey     String?
  mimeType     String
  sizeBytes    BigInt
  durationMs   Int?
  contentHash  String? // SHA-256 (lo calcula el navegador): evita subir el mismo dos veces
  status       String         @default("UPLOADING") // UPLOADING | READY
  location     String         @default("GALLERY") // GALLERY | VAULT
  vaultedAt    DateTime?
  uploadedById String
  uploadedBy   User           @relation("PlaceMediaUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([placeId, status, location])
}

/// Conversación 1 a 1. `pairKey` = los dos userId ordenados y unidos con "|",
/// así la misma pareja siempre reutiliza la conversación (única).
model ChatConversation {
  id            String          @id @default(cuid())
  /// DIRECT = 1 a 1 (usa pairKey) · CHANNEL = canal de la comunidad de un lugar.
  kind          String          @default("DIRECT")
  pairKey       String?         @unique // solo DIRECT
  /// Solo CHANNEL: el lugar dueño, nombre, descripción y si es el General.
  placeId       String?
  place         CommunityPlace? @relation(fields: [placeId], references: [id], onDelete: Cascade)
  name          String?
  description   String?
  isGeneral     Boolean         @default(false)
  /// Solo CLASS: academia y clase (sin relación: la clase vive en el módulo de academias).
  academyId     String?
  classId       String?
  createdById   String?
  lastMessageAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([lastMessageAt])
  @@index([placeId])
  @@index([classId])
}

model ChatParticipant {
  conversationId String
  userId         String
  /// Hasta cuándo leyó: los mensajes posteriores (de otros) cuentan como no leídos.
  lastReadAt     DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id])

  @@id([conversationId, userId])
  @@index([userId])
}

/// Mensaje de chat. Historial permanente: nunca se borra. Puede llevar una
/// imagen (base64, comprimida en el cliente); `body` puede ir vacío en ese caso.
model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  imageData      String? // base64, sin prefijo data:
  imageMime      String?
  imageWidth     Int?
  imageHeight    Int?
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation("ChatMessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

// ─── Módulo Estudio (análisis musical de bachatas) ──────────────────────────

/**
 * Análisis COMPARTIDO de una grabación. Sin dueño: lo reutilizan todos los
 * archivos con la misma huella acústica (Chromaprint). Solo guarda datos sobre la
 * canción (tiempos, energía); el audio de cada usuario nunca se comparte. Se
 * borra cuando ya ningún AudioFile lo referencia.
 */
model RecordingAnalysis {
  id                 String   @id @default(cuid())
  status             String   @default("PENDING") // AnalysisStatus: PENDING | PROCESSING | DONE | ERROR
  analyzerVersion    String?
  durationMs         Int?
  fingerprint        Json? // number[] (Chromaprint crudo)
  bpm                Float?
  firstBeatOffsetMs  Int? // el "1" automático de la frase de 8
  beatsMs            Json? // number[]
  downbeatsMs        Json? // number[]
  energy             Json? // { stepMs, values }
  sections           Json? // automáticas [{ type, startMs, endMs }] (Fase 2)
  markers            Json? // automáticas [{ type, timeMs }] (Fase 2)
  error              String?
  instrumentsStatus  String   @default("PENDING") // AnalysisStatus
  instrumentsVersion String? // versión del analizador que midió los instrumentos
  instruments        Json? // { stepMs, tracks: { vocals: number[], ... } } (SongInstruments)
  instrumentsError   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  audioFiles AudioFile[]

  @@index([durationMs]) // candidatos para comparar huellas
}

/**
 * Archivo de audio que subió un usuario. PRIVADO: solo su dueño lo ve (URLs
 * firmadas de corta duración). Es la "capa del usuario" sobre la grabación: su
 * "1" corregido, sus secciones y sus marcas.
 */
model AudioFile {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId           String? // vínculo opcional con el catálogo
  track             Track?             @relation(fields: [trackId], references: [id], onDelete: SetNull)
  storageKey        String             @unique
  style             String             @default("BACHATA") // DanceStyle: define las reglas de secciones
  originalName      String
  mimeType          String
  sizeBytes         Int
  durationMs        Int? // de ESTE archivo (puede diferir de la grabación compartida)
  status            String             @default("UPLOADING") // AudioFileStatus: UPLOADING | QUEUED | PROCESSING | READY | ERROR
  error             String?
  recordingId       String?
  recording         RecordingAnalysis? @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  alignOffsetMs     Int                @default(0) // tiempo en ESTE archivo = tiempo en la grabación + alignOffsetMs
  firstBeatOffsetMs Int? // el "1" corregido por el usuario (null = el automático)
  stemsStatus       String? // pistas para el mezclador (AnalysisStatus); null = no se pidieron
  stemsError        String?
  rightsAcceptedAt  DateTime // declaró tener derecho a usar el archivo para su práctica
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  sections SongSection[]
  markers  SongMarker[]

  @@index([userId])
  @@index([recordingId])
}

/**
 * Sección de la canción en la línea de tiempo del archivo del usuario.
 */
model SongSection {
  id          String    @id @default(cuid())
  audioFileId String
  audioFile   AudioFile @relation(fields: [audioFileId], references: [id], onDelete: Cascade)
  type        String // SongSectionType: INTRO | VERSO | CORO | MAJAO | MAMBO | PUENTE | OUTRO | OTRO
  startMs     Int
  endMs       Int
  label       String?
  origin      String // MarkOrigin: AUTOMATICO | MANUAL

  @@index([audioFileId])
}

/**
 * Break, acento, corte o nota personal en un momento de la canción.
 */
model SongMarker {
  id          String    @id @default(cuid())
  audioFileId String
  audioFile   AudioFile @relation(fields: [audioFileId], references: [id], onDelete: Cascade)
  type        String // SongMarkerType: BREAK | ACENTO | CORTE | NOTA
  timeMs      Int
  text        String?
  origin      String // MarkOrigin
  createdAt   DateTime  @default(now())

  @@index([audioFileId])
}

/// Academia de baile: perfil público (para usuarios con cuenta), horario de clases
/// y videos de las clases. La administran su dueño y los profesores que agregue.
model Academy {
  id              String    @id @default(cuid())
  name            String
  region          String // ChileRegion (code)
  city            String? // ciudad (área urbana, CHILE_CITIES de @baile-latino/types)
  commune         String? // comuna dentro de la ciudad
  address         String?
  styles          String    @default("") // CSV de DanceStyle
  description     String?
  instagramHandle String? // sin @
  logoData        String? // base64, sin prefijo data:
  logoMime        String?
  storageQuotaMb  Int       @default(51200) // cupo de fotos y videos (50 GB)
  vaultQuotaMb    Int       @default(204800) // cupo de la bóveda (200 GB): archivo barato, solo descarga
  // Plan Director (la suscripción que paga el dueño): vigente hasta esta fecha.
  // null o vencido = solo lectura (se ve y se descarga, no se sube ni se mueve).
  // Por ahora lo activa el SUPER_ADMIN a mano (Admin → Academias).
  planExpiresAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  members    AcademyMember[]
  classes    AcademyClass[]
  videos     AcademyVideo[]
  shareLinks AcademyShareLink[]

  @@index([region])
}

/// Quién administra la academia: OWNER (uno, el que la creó) o TEACHER.
model AcademyMember {
  id        String   @id @default(cuid())
  academyId String
  academy   Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // AcademyMemberRole: OWNER | TEACHER
  createdAt DateTime @default(now())

  @@unique([academyId, userId])
  @@index([userId])
}

/// Clase del horario semanal (informativa: sin reservas ni pagos).
model AcademyClass {
  id          String   @id @default(cuid())
  academyId   String
  academy     Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  title       String
  style       String? // DanceStyle
  level       String   @default("TODOS") // ClassLevel: BASICO | INTERMEDIO | AVANZADO | TODOS
  weekday     Int // 0 = domingo … 6 = sábado
  startTime   String // "HH:mm"
  durationMin Int      @default(60)
  teacherName String?
  place       String?
  priceInfo   String?
  description String?
  active      Boolean  @default(true)
  /// Cupo máximo de alumnos (null = sin cupo).
  capacity    Int?
  /// Chat de grupo de la clase (ChatConversation kind CLASS); se crea al aceptar al primer alumno.
  chatId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  videos      AcademyVideo[]
  shareLinks  AcademyShareLink[]
  enrollments AcademyEnrollment[]

  @@index([academyId])
}

/// Solicitud / inscripción de un alumno a una clase. La acepta o rechaza el director.
/// Aceptado = aparece en la lista, ve los videos de la clase y entra a su chat.
model AcademyEnrollment {
  id        String       @id @default(cuid())
  classId   String
  class     AcademyClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("AcademyEnrollmentUser", fields: [userId], references: [id], onDelete: Cascade)
  status    String       @default("PENDING") // PENDING | ACCEPTED | REJECTED
  message   String? // lo que escribió el alumno al pedir
  decidedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([classId, userId])
  @@index([userId])
  @@index([classId, status])
}

/// Video o foto de una academia (el tipo sale de mimeType) en el bucket de media (R2, privado: se ve por URL firmada).
model AcademyVideo {
  id              String        @id @default(cuid())
  academyId       String
  academy         Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  classId         String?
  class           AcademyClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  style           String? // DanceStyle
  recordedOn      DateTime? // día de la clase
  storageKey      String        @unique
  thumbKey        String? // miniatura JPG (la saca el navegador)
  pendingThumbKey String? // miniatura nueva subiéndose (al confirmar pasa a thumbKey)
  mimeType        String
  sizeBytes       BigInt
  durationMs      Int?
  contentHash     String? // SHA-256 del archivo (lo calcula el navegador): evita subir el mismo dos veces
  status          String        @default("UPLOADING") // AcademyVideoStatus: UPLOADING | READY
  location        String        @default("GALLERY") // AcademyMediaLocation: GALLERY | VAULT (R2 Infrequent Access: no se reproduce, solo se descarga)
  vaultedAt       DateTime?
  compatStatus    String? // AcademyCompatStatus: PENDING | PROCESSING | DONE | NOT_NEEDED | TOO_LONG | ERROR (null = sin revisar o en la bóveda)
  compatKey       String? // copia MP4 H.264 SDR <= 1080p (no cuenta en el cupo de la academia)
  compatSizeBytes BigInt?
  compatError     String?
  uploadedById    String
  uploadedBy      User          @relation("AcademyVideoUploadedBy", fields: [uploadedById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  reports AcademyVideoReport[]

  @@index([academyId, status, location])
  @@index([academyId, contentHash])
  @@index([classId])
}

/// Reporte de un video (derecho de imagen, contenido inapropiado…). Lo revisa el super admin.
model AcademyVideoReport {
  id         String       @id @default(cuid())
  videoId    String
  video      AcademyVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([videoId, reporterId])
  @@index([resolvedAt])
}

/// Link para compartir las fotos y videos de UNA clase. Hoy es público (cualquiera
/// con el link ve y descarga, sin cuenta); a futuro `access` = MEMBERS pedirá ser
/// miembro de la academia. Se desactiva con revokedAt (el token deja de funcionar).
model AcademyShareLink {
  id          String       @id @default(cuid())
  token       String       @unique
  academyId   String
  academy     Academy      @relation(fields: [academyId], references: [id], onDelete: Cascade)
  classId     String
  class       AcademyClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  access      String       @default("PUBLIC") // AcademyShareAccess: PUBLIC | MEMBERS (futuro)
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  revokedAt   DateTime?

  @@index([classId, revokedAt])
}
