// Baile Latino Platform — schema de la API. PostgreSQL (dev y prod).
// Dev local: Postgres vía docker-compose. Prod: Postgres gestionado (Railway/Neon).
//
// NOTA: los campos "enum" se guardan como String validados contra los arrays de
// @baile-latino/types, y las listas (p. ej. estilos del usuario) como CSV (se
// mantiene así por compatibilidad histórica).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7: la URL no va aquí. Para migraciones/db push vive en prisma.config.ts;
  // en runtime el cliente se conecta vía driver adapter (pg) — ver prisma.service.ts.
  provider = "postgresql"
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String? // opcional: los usuarios que solo entran con Google no tienen contraseña
  googleId         String?  @unique // vinculación con cuenta de Google
  emailVerified    Boolean  @default(false) // true si un proveedor (Google) verificó el email
  name             String
  role             String   @default("BAILARIN") // UserRole
  city             String?
  instagramHandle  String?
  styles           String   @default("") // CSV de DanceStyle
  // Preferencia de baile: BACHATA | SALSA | AMBOS. null = todavía no la eligió,
  // y por eso se le pregunta al entrar.
  stylePreference  String?
  refreshTokenHash String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tracksCreated   Track[]               @relation("TrackCreatedBy")
  tracksAsArtist  Track[]               @relation("TrackArtist")
  ownedTracks     Track[]               @relation("TrackOwner")
  library         UserTrack[]
  trackTags       TrackTag[]
  playlists       Playlist[]
  songRequests    SongRequest[]
  requestVotes    RequestVote[]
  ytAccessRequest YoutubeAccessRequest?
  events          Event[]               @relation("EventCreatedBy")
  communityPlaces CommunityPlace[]      @relation("CommunityPlaceCreatedBy")
  chatMemberships ChatParticipant[]
  chatMessages    ChatMessage[]         @relation("ChatMessageSender")
  audioFiles      AudioFile[]

  @@index([role])
}

/**
 * Solicitud de un usuario para que lo habiliten a conectar su YouTube (agregarlo
 * como "test user" en Google Cloud). Una por usuario: volver a pedir actualiza el
 * correo y la vuelve a dejar PENDING. El admin la marca ADDED tras cargar el
 * correo en la consola de Google (paso manual: Google no tiene API para eso).
 */
model YoutubeAccessRequest {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String // Gmail con el que el usuario va a autorizar YouTube
  status     String    @default("PENDING") // PENDING | ADDED | REJECTED
  note       String? // nota opcional del admin
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reviewedAt DateTime?

  @@index([status])
}

model Track {
  id              String   @id @default(cuid())
  title           String
  artist          String
  style           String // DanceStyle
  substyle        String? // DanceSubstyle
  year            Int?
  source          String // TrackSource: SPOTIFY | YOUTUBE
  sourceId        String
  coverUrl        String?
  durationSec     Int?
  searchText      String? // título+artista normalizado (sin acentos, minúsculas) para buscar; lo mantiene un trigger
  viewCount       BigInt? // reproducciones (de ytMetadata.viewCount), para ordenar
  popularity      Int? // índice de popularidad de Spotify (0-100); Spotify no expone streams
  releaseDate     String? // fecha de lanzamiento de Spotify ("2024-04-04" | "2024-04" | "2024" | "" = sin dato)
  spotifyPlayable Boolean? // Spotify: ¿reproducible en el embed? false = restringida (país/licencia); null = desconocido
  isRelease       Boolean  @default(false)
  approvalStatus  String   @default("APROBADA") // TrackApprovalStatus
  scope           String   @default("CATALOG") // TrackScope: CATALOG (global) | PERSONAL (privada del DJ)
  ownerId         String? // dueño cuando scope = PERSONAL
  ytMetadata      String? // JSON con todos los datos extraídos de YouTube (snippet, stats, status, etc.)
  artistUserId    String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner         User?          @relation("TrackOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  artistUser    User?          @relation("TrackArtist", fields: [artistUserId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("TrackCreatedBy", fields: [createdById], references: [id])
  playlistItems PlaylistItem[]
  songRequests  SongRequest[]
  savedBy       UserTrack[]
  trackTags     TrackTag[]
  audioFiles    AudioFile[] // audios de usuarios vinculados a esta canción (módulo Estudio)

  // Sin unique global de (source,sourceId): el mismo video puede estar en el
  // catálogo y además como copia personal de uno o más DJs. Dedupe en la app.
  @@index([source, sourceId])
  @@index([scope])
  @@index([ownerId])
  @@index([style])
  @@index([substyle])
  @@index([viewCount])
}

/// Configuración global de la plataforma (clave/valor JSON). P.ej. la matriz
/// de permisos rol×módulo (ver/editar/eliminar).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Vocabulario global de tags (sub-estilos). Único por `slug` normalizado
/// (sin distinguir mayúsculas/acentos/puntuación). Lo administra el SUPER_ADMIN,
/// pero un DJ también puede crear uno nuevo al etiquetar.
model Tag {
  id          String   @id @default(cuid())
  name        String // texto a mostrar
  slug        String // normalizado para deduplicar (único por estilo, no global)
  style       String? // categoría: BACHATA | SALSA | null (general)
  createdById String
  createdAt   DateTime @default(now())

  tracks TrackTag[]

  // El mismo nombre puede existir en cada estilo (ej: "Romántica" en bachata y salsa).
  @@unique([slug, style])
}

/// Asociación DJ↔canción↔tag (cada DJ etiqueta según su apreciación).
model TrackTag {
  id        String   @id @default(cuid())
  trackId   String
  userId    String
  tagId     String
  createdAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([trackId, userId, tagId])
  @@index([trackId])
  @@index([tagId])
  @@index([userId])
}

/// Biblioteca personal: canciones (de catálogo o personales) en "Mis Canciones".
model UserTrack {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId])
}

model Playlist {
  id               String   @id @default(cuid())
  name             String
  source           String   @default("YOUTUBE") // plataforma: YOUTUBE | SPOTIFY
  eventId          String? // FK lógica al futuro EventsModule (sin constraint aún)
  status           String   @default("BORRADOR") // PlaylistStatus
  visibility       String   @default("SOLO_ENTRADA") // PlaylistVisibility
  targetBachataPct Int? // 0-100; resto se asume salsa
  bachatasPerBlock Int? // patrón de distribución: bachatas por bloque
  salsasPerBlock   Int? // patrón de distribución: salsas por bloque
  ownerId          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner User           @relation(fields: [ownerId], references: [id])
  items PlaylistItem[]

  @@index([ownerId])
  @@index([eventId])
}

model PlaylistItem {
  id         String  @id @default(cuid())
  playlistId String
  trackId    String
  position   Int
  isWarmup   Boolean @default(false)
  addedById  String

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  // Sin unique por (playlistId, trackId) a propósito: una playlist PUEDE tener la
  // misma canción varias veces (en un social, un tema muy bueno se repite 3-4
  // veces en una sesión de 4-5 horas). Cada aparición es un PlaylistItem propio.
  @@index([playlistId])
  @@index([trackId])
}

model SongRequest {
  id          String   @id @default(cuid())
  eventId     String?
  trackId     String
  requesterId String
  status      String   @default("PENDIENTE") // SongRequestStatus
  createdAt   DateTime @default(now())

  track     Track         @relation(fields: [trackId], references: [id], onDelete: Cascade)
  requester User          @relation(fields: [requesterId], references: [id])
  votes     RequestVote[]

  @@index([eventId])
  @@index([trackId])
}

model RequestVote {
  id        String   @id @default(cuid())
  requestId String
  userId    String
  createdAt DateTime @default(now())

  request SongRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])

  @@unique([requestId, userId])
}

/// Configuración global del sitio (fila única id="singleton"). El logo se guarda
/// como base64 en la DB para que persista entre despliegues y lo sirvan ambos
/// clientes (web/mobile) vía la API, sin depender de storage externo.
model SiteSetting {
  id        String   @id @default("singleton")
  siteName  String?
  logoData  String? // base64 del logo, sin el prefijo data:
  logoMime  String? // tipo MIME (image/png, image/svg+xml, …)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Evento de la comunidad (social, show, taller…). El flyer se guarda en base64
/// igual que el logo del sitio; las listas nunca lo seleccionan (ver events.service).
model Event {
  id                 String    @id @default(cuid())
  title              String
  description        String?
  startsAt           DateTime
  endsAt             DateTime?
  region             String // ChileRegion (code)
  city               String?
  venueName          String?
  address            String?
  styles             String    @default("") // CSV de DanceStyle
  bachataPct         Int? // % de bachata en la noche (0-100)
  priceInfo          String? // texto libre con precios / preventas
  ticketUrl          String?
  instagramUrl       String?
  organizerName      String?
  organizerInstagram String?
  status             String    @default("PUBLISHED") // EventStatus
  flyerData          String? // base64 del flyer, sin prefijo data:
  flyerMime          String?
  createdById        String
  createdBy          User      @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([region, startsAt])
  @@index([startsAt])
  @@index([createdById])
}

/// Ficha de un directorio de la comunidad (social al aire libre, salsoteca, DJ
/// disponible…). Sin fecha única: horario/disponibilidad en texto y las cuentas
/// de Instagram asociadas. `kind` distingue el tipo (CommunityPlaceKind).
model CommunityPlace {
  id               String   @id @default(cuid())
  kind             String // CommunityPlaceKind: OUTDOOR_SOCIAL | SALSOTECA | DJ
  name             String
  region           String // ChileRegion (code)
  city             String?
  place            String?
  address          String?
  schedule         String? // texto libre, ej. "Domingos desde las 17:00"
  styles           String   @default("") // CSV de DanceStyle
  description      String?
  instagramHandles String   @default("") // CSV de handles sin @
  photoData        String? // base64, sin prefijo data:
  photoMime        String?
  active           Boolean  @default(true)
  createdById      String
  createdBy        User     @relation("CommunityPlaceCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([kind, region])
  @@index([createdById])
}

/// Conversación 1 a 1. `pairKey` = los dos userId ordenados y unidos con "|",
/// así la misma pareja siempre reutiliza la conversación (única).
model ChatConversation {
  id            String    @id @default(cuid())
  pairKey       String    @unique
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([lastMessageAt])
}

model ChatParticipant {
  conversationId String
  userId         String
  /// Hasta cuándo leyó: los mensajes posteriores (de otros) cuentan como no leídos.
  lastReadAt     DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id])

  @@id([conversationId, userId])
  @@index([userId])
}

/// Mensaje de chat. Historial permanente: nunca se borra. Puede llevar una
/// imagen (base64, comprimida en el cliente); `body` puede ir vacío en ese caso.
model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  imageData      String? // base64, sin prefijo data:
  imageMime      String?
  imageWidth     Int?
  imageHeight    Int?
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation("ChatMessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

// ─── Módulo Estudio (análisis musical de bachatas) ──────────────────────────

/**
 * Análisis COMPARTIDO de una grabación. Sin dueño: lo reutilizan todos los
 * archivos con la misma huella acústica (Chromaprint). Solo guarda datos sobre la
 * canción (tiempos, energía); el audio de cada usuario nunca se comparte. Se
 * borra cuando ya ningún AudioFile lo referencia.
 */
model RecordingAnalysis {
  id                String   @id @default(cuid())
  status            String   @default("PENDING") // AnalysisStatus: PENDING | PROCESSING | DONE | ERROR
  analyzerVersion   String?
  durationMs        Int?
  fingerprint       Json? // number[] (Chromaprint crudo)
  bpm               Float?
  firstBeatOffsetMs Int? // el "1" automático de la frase de 8
  beatsMs           Json? // number[]
  downbeatsMs       Json? // number[]
  energy            Json? // { stepMs, values }
  sections          Json? // automáticas [{ type, startMs, endMs }] (Fase 2)
  markers           Json? // automáticas [{ type, timeMs }] (Fase 2)
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  audioFiles AudioFile[]

  @@index([durationMs]) // candidatos para comparar huellas
}

/**
 * Archivo de audio que subió un usuario. PRIVADO: solo su dueño lo ve (URLs
 * firmadas de corta duración). Es la "capa del usuario" sobre la grabación: su
 * "1" corregido, sus secciones y sus marcas.
 */
model AudioFile {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId           String? // vínculo opcional con el catálogo
  track             Track?             @relation(fields: [trackId], references: [id], onDelete: SetNull)
  storageKey        String             @unique
  originalName      String
  mimeType          String
  sizeBytes         Int
  durationMs        Int? // de ESTE archivo (puede diferir de la grabación compartida)
  status            String             @default("UPLOADING") // AudioFileStatus: UPLOADING | QUEUED | PROCESSING | READY | ERROR
  error             String?
  recordingId       String?
  recording         RecordingAnalysis? @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  alignOffsetMs     Int                @default(0) // tiempo en ESTE archivo = tiempo en la grabación + alignOffsetMs
  firstBeatOffsetMs Int? // el "1" corregido por el usuario (null = el automático)
  rightsAcceptedAt  DateTime // declaró tener derecho a usar el archivo para su práctica
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  sections SongSection[]
  markers  SongMarker[]

  @@index([userId])
  @@index([recordingId])
}

/**
 * Sección de la canción en la línea de tiempo del archivo del usuario.
 */
model SongSection {
  id          String    @id @default(cuid())
  audioFileId String
  audioFile   AudioFile @relation(fields: [audioFileId], references: [id], onDelete: Cascade)
  type        String // SongSectionType: INTRO | VERSO | CORO | MAJAO | MAMBO | PUENTE | OUTRO | OTRO
  startMs     Int
  endMs       Int
  label       String?
  origin      String // MarkOrigin: AUTOMATICO | MANUAL

  @@index([audioFileId])
}

/**
 * Break, acento, corte o nota personal en un momento de la canción.
 */
model SongMarker {
  id          String    @id @default(cuid())
  audioFileId String
  audioFile   AudioFile @relation(fields: [audioFileId], references: [id], onDelete: Cascade)
  type        String // SongMarkerType: BREAK | ACENTO | CORTE | NOTA
  timeMs      Int
  text        String?
  origin      String // MarkOrigin
  createdAt   DateTime  @default(now())

  @@index([audioFileId])
}
