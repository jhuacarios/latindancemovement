# Copiar a deploy/.env EN EL SERVIDOR y completar. Nunca commitear deploy/.env.
# Valores aleatorios: openssl rand -hex 32

# --- Base de datos (Postgres en el mismo servidor) ---
POSTGRES_USER=nectason
POSTGRES_PASSWORD=
POSTGRES_DB=nectason

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
SUPER_ADMIN_EMAILS=
# La PRIMERA URL es a la que vuelve el login con Google; el resto solo CORS.
WEB_URL=https://nectason.app,https://www.nectason.app,https://latindancemovement.vercel.app

# --- Google (mismos valores que tenía Railway; ver DEPLOY.md) ---
YOUTUBE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.nectason.app/api/v1/music/youtube/callback
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=https://api.nectason.app/api/v1/auth/google/callback

# --- Spotify (en pausa; opcional) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Anthropic (lectura de flyers de eventos) ---
ANTHROPIC_API_KEY=

# --- Estudio: storage en Cloudflare R2 ---
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=nectason-audio-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STUDIO_MAX_UPLOAD_MB=30
# Token compartido API <-> analizador (los dos lo leen de este archivo).
ANALYZER_TOKEN=
